==== 1.1

  PRAGMA page_size=1024;
  PRAGMA auto_vacuum=0;
  CREATE TABLE t1(x);

  INSERT INTO t1 VALUES(randomblob(20));
  INSERT INTO t1 VALUES(randomblob(100));   -- make this into a free slot
  INSERT INTO t1 VALUES(randomblob(27));    -- this one will be corrupt
  INSERT INTO t1 VALUES(randomblob(800));

  DELETE FROM t1 WHERE rowid=2;  -- free the 100 byte slot
  PRAGMA page_count
----
stmt 0 ok
stmt 25 ok
stmt 49 ok
stmt 71 err 1 -1 113 no such table: t1
stmt 113 err 1 -1 155 no such table: t1
stmt 155 err 1 -1 228 no such table: t1
stmt 228 err 1 -1 301 no such table: t1
stmt 301 err 1 -1 334 no such table: t1
stmt 334 ok
